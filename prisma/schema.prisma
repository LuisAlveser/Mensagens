generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/client/"

}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  imagem       String?
  nome         String
  senha        String
  membros      MembrosSala[]
  mensagens    Mensagem[]
  salasCriadas Sala[]
}

model Sala {
  id        String        @id @default(uuid())
  nome      String
  categoria String
  createdAt DateTime      @default(now())
  descricao String
  imagem    String
  admin     String
  membros   MembrosSala[]
  mensagens Mensagem[]
  user      User          @relation(fields: [admin], references: [id],onDelete: Cascade)
}

model MembrosSala {
  userId String
  salaId String
  sala   Sala   @relation(fields: [salaId], references: [id],onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id],onDelete: Cascade)

  @@id([userId, salaId])
}

model Mensagem {
  id        String   @id @default(uuid())
  conteudo  String
  userId    String
  salaId    String
  createdAt DateTime @default(now())
  sala      Sala     @relation(fields: [salaId], references: [id],onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id],onDelete: Cascade)
}
